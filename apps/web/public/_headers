# Security headers for static hosts that read _headers (Cloudflare Pages, Netlify).
# The script-src hash is the inline theme script in index.html. The build (security/headers.ts)
# fails if the two drift, and `vite preview` serves these same headers for e2e.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-F9HwYkKZ3hnqe1sDvu1auWclbiektsFvA+D/dacSXMc='; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=(), bluetooth=(), display-capture=(), xr-spatial-tracking=()

/sw.js
  Cache-Control: no-cache
